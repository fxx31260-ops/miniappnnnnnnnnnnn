    const sectionEl = document.getElementById("section");
    const nameEl = document.getElementById("name");
    const tariffEl = document.getElementById("tariff");
    const targetEl = document.getElementById("target");
    const calcBlockEl = document.getElementById("calcBlock");
    const calcTitleEl = document.getElementById("calcTitle");
    const fixedTotalBlockEl = document.getElementById("fixedTotalBlock");
    const fixedTotalEl = document.getElementById("fixedTotal");
    const qtyEl = document.getElementById("qty");
    const totalEl = document.getElementById("total");
    const sendEl = document.getElementById("send");

    function hasCalc() {
      return sectionEl.value === "Накрутка соцсетей" || nameEl.value === "Roblox";
    }

    function fill(el, list) {
      el.innerHTML = "";
      list.forEach(item => {
        const opt = document.createElement("option");
        opt.value = item;
        opt.textContent = item;
        el.appendChild(opt);
      });
    }

    function updateNames() {
      fill(nameEl, Object.keys(CATALOG[sectionEl.value] || {}));
      updateTariffs();
    }

    function updateTariffs() {
      const showCalc = hasCalc();
      calcBlockEl.classList.toggle("hidden", !showCalc);
      fixedTotalBlockEl.classList.toggle("hidden", showCalc);
      calcTitleEl.textContent = nameEl.value === "Roblox"
        ? "Калькулятор Robux (1 Robux = 1 ₽)"
        : "Калькулятор накрутки (за 1 шт)";

      const tariffs = (CATALOG[sectionEl.value] || {})[nameEl.value] || {};
      tariffEl.innerHTML = "";
      Object.entries(tariffs).forEach(([t, p]) => {
        const opt = document.createElement("option");
        opt.value = t;
        opt.textContent = sectionEl.value === "Накрутка соцсетей" ? `${t} — ${p} ₽/шт` : `${t} — ${p} ₽`;
        tariffEl.appendChild(opt);
      });
      calc();
    }

    function calc() {
      const tariffs = (CATALOG[sectionEl.value] || {})[nameEl.value] || {};
      const price = Number(tariffs[tariffEl.value] || 0);
      if (!hasCalc()) {
        fixedTotalEl.textContent = `${price} ₽`;
        return { price, qty: 1, sum: price };
      }
      const qty = Math.max(1, parseInt(qtyEl.value, 10) || 1);
      const sum = Math.round(price * qty * 1000) / 1000;
      totalEl.textContent = `${sum} ₽`;
      return { price, qty, sum };
    }

    sectionEl.addEventListener("change", updateNames);
    nameEl.addEventListener("change", updateTariffs);
    tariffEl.addEventListener("change", calc);
    qtyEl.addEventListener("input", calc);

    sendEl.addEventListener("click", () => {
      const { price, qty, sum } = calc();
      const target = targetEl.value.trim();
      if (!target) return alert("Укажите ссылку или ID");

      tg.sendData(JSON.stringify({
        section: sectionEl.value,
        name: nameEl.value,
        tariff: tariffEl.value,
        price,
        qty: hasCalc() ? qty : 1,
        total: hasCalc() ? sum : price,
        target
      }));
    });

    fill(sectionEl, Object.keys(CATALOG));
    updateNames();
  </script>
