  <title>Магазин</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: var(--tg-theme-bg-color, #111);
      color: var(--tg-theme-text-color, #fff);
      padding: 16px;
      margin: 0;
    }
    .box {
      max-width: 480px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    select, input, button {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid #444;
      background: var(--tg-theme-secondary-bg-color, #222);
      color: var(--tg-theme-text-color, #fff);
      font-size: 15px;
      box-sizing: border-box;
    }
    button {
      background: var(--tg-theme-button-color, #2ea6ff);
      color: var(--tg-theme-button-text-color, #fff);
      border: none;
      font-weight: bold;
      cursor: pointer;
    }
    .calc-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid #444;
      background: var(--tg-theme-secondary-bg-color, #222);
    }
    .calc-box.hidden {
      display: none;
    }
    .total {
      font-size: 18px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="box">
    <h3>Донат и накрутка</h3>

    <select id="section"></select>
    <select id="name"></select>
    <select id="tariff"></select>

    <input id="target" type="text" placeholder="Ссылка или ID игрока" />

    <div id="calcBlock" class="calc-box">
      <div id="calcTitle">Калькулятор (за 1 шт)</div>
      <input id="qty" type="number" min="1" value="1" placeholder="Количество" />
      <div class="total">Итого: <span id="total">0 ₽</span></div>
    </div>

    <div id="fixedTotalBlock" class="total hidden">Итого: <span id="fixedTotal">0 ₽</span></div>

    <button id="send">Оформить заказ</button>
  </div>

